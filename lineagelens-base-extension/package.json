{
  "name": "lineagelens",
  "displayName": "LineageLens",
  "description": "Lightweight AI code provenance \u00e2\u20ac\u201d capture and review every AI-generated insertion locally, no server required.",
  "version": "1.2.0",
  "publisher": "karnatipraveen",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/karnati-praveen/lineagelens"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "ai",
    "provenance",
    "copilot",
    "code-tracking",
    "lineage"
  ],
  "icon": "images/icon.png",
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "lineagelens-base",
          "title": "LineageLens",
          "icon": "images/sidebar-icon.svg"
        }
      ]
    },
    "views": {
      "lineagelens-base": [
        {
          "id": "lineagelens.captures",
          "name": "AI Captures",
          "type": "tree"
        }
      ]
    },
    "commands": [
      {
        "command": "lineagelens.openCapture",
        "title": "LineageLens: View Capture Details"
      },
      {
        "command": "lineagelens.clearAll",
        "title": "LineageLens: Clear All Captures",
        "icon": "$(trash)"
      },
      {
        "command": "lineagelens.exportJson",
        "title": "LineageLens: Export Captures as JSON"
      },
      {
        "command": "lineagelens.refreshSidebar",
        "title": "LineageLens: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "lineagelens.insertAtCursor",
        "title": "Insert at Cursor",
        "icon": "$(pencil)"
      },
      {
        "command": "lineagelens.copyCode",
        "title": "Copy Code",
        "icon": "$(copy)"
      }
    ],
    "viewsWelcome": [
      {
        "view": "lineagelens.captures",
        "contents": "No AI captures yet.\n\nLineageLens automatically detects when an AI tool inserts 4+ lines of code into your editor.\n\nJust use Copilot, Cursor, Claude, or any AI coding tool \u00e2\u20ac\u201d captures will appear here.\n\n[Learn More](https://github.com/karnati-praveen/lineagelens)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "lineagelens.refreshSidebar",
          "when": "view == lineagelens.captures",
          "group": "navigation@1"
        },
        {
          "command": "lineagelens.clearAll",
          "when": "view == lineagelens.captures",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "lineagelens.insertAtCursor",
          "when": "view == lineagelens.captures && viewItem == captureRecord",
          "group": "inline@1"
        },
        {
          "command": "lineagelens.copyCode",
          "when": "view == lineagelens.captures && viewItem == captureRecord",
          "group": "inline@2"
        },
        {
          "command": "lineagelens.insertAtCursor",
          "when": "view == lineagelens.captures && viewItem == captureRecord",
          "group": "1_capture@1"
        },
        {
          "command": "lineagelens.copyCode",
          "when": "view == lineagelens.captures && viewItem == captureRecord",
          "group": "1_capture@2"
        },
        {
          "command": "lineagelens.openCapture",
          "when": "view == lineagelens.captures && viewItem == captureRecord",
          "group": "1_capture@3"
        }
      ]
    },
    "configuration": {
      "title": "LineageLens Base",
      "properties": {
        "lineagelensBase.minInsertionLines": {
          "type": "number",
          "default": 4,
          "minimum": 1,
          "description": "Minimum number of consecutive lines inserted to trigger a capture."
        },
        "lineagelensBase.captureEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable or disable AI insertion capture."
        },
        "lineagelensBase.maxStoredCaptures": {
          "type": "number",
          "default": 1000,
          "minimum": 10,
          "description": "Maximum number of captures to keep locally."
        },
        "lineagelensBase.excludePatterns": {
          "type": "array",
          "default": [
            "**/node_modules/**",
            "**/.git/**",
            "**/dist/**"
          ],
          "description": "Glob patterns for files to exclude from capture."
        }
      }
    }
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --minify",
    "watch": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --sourcemap --watch",
    "package": "vsce package",
    "test": "jest"
  },
  "dependencies": {
    "minimatch": "^9.0.4"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.22.0",
    "esbuild": "^0.19.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.9",
    "typescript": "^5.3.0"
  }
}
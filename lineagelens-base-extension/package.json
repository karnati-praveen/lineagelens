{
  "name": "lineagelens-base",
  "displayName": "LineageLens Base",
  "description": "Lightweight AI code provenance \u2014 capture and review every AI-generated insertion locally, no server required.",
  "_extensionRole": "BASE \u2014 zero-server standalone edition. Install for local-only capture with no backend, no proxy, and no account required. The full server-connected edition (Lite/Plus/Max) lives in the repo root package.json.",
  "version": "1.3.0",
  "publisher": "karnatipraveen",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/karnati-praveen/lineagelens"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "ai",
    "provenance",
    "copilot",
    "code-tracking",
    "lineage"
  ],
  "icon": "images/icon.png",
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "lineagelens-base",
          "title": "LineageLens",
          "icon": "images/sidebar-icon.svg"
        }
      ]
    },
    "views": {
      "lineagelens-base": [
        {
          "id": "lineagelens.captures",
          "name": "AI Captures",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "lineagelens.openCapture",
        "title": "LineageLens: View Capture Details"
      },
      {
        "command": "lineagelens.clearAll",
        "title": "LineageLens: Clear All Captures",
        "icon": "$(trash)"
      },
      {
        "command": "lineagelens.exportJson",
        "title": "LineageLens: Export Captures as JSON"
      },
      {
        "command": "lineagelens.refreshSidebar",
        "title": "LineageLens: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "lineagelens.insertAtCursor",
        "title": "Insert at Cursor",
        "icon": "$(pencil)"
      },
      {
        "command": "lineagelens.copyCode",
        "title": "Copy Code",
        "icon": "$(copy)"
      },
      {
        "command": "lineagelens.deleteCapture",
        "title": "Delete Capture",
        "icon": "$(trash)"
      },
      {
        "command": "lineagelens.revealInFile",
        "title": "Reveal in File",
        "icon": "$(go-to-file)"
      },
      {
        "command": "lineagelens.showModeInfo",
        "title": "LineageLens: Show Mode Status"
      },
      {
        "command": "lineagelens.exportAgentTrace",
        "title": "LineageLens: Export Agent Trace"
      },
      {
        "command": "lineagelens.openWelcome",
        "title": "LineageLens: Open Welcome",
        "category": "LineageLens"
      },
      {
        "command": "lineagelens.saveEmail",
        "title": "LineageLens: Save / Update My Email",
        "category": "LineageLens"
      },
      {
        "command": "lineagelens.removeEmail",
        "title": "LineageLens: Remove My Email",
        "category": "LineageLens"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "lineagelens.refreshSidebar",
          "when": "view == lineagelens.captures",
          "group": "navigation@1"
        },
        {
          "command": "lineagelens.clearAll",
          "when": "view == lineagelens.captures",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "lineagelens.insertAtCursor",
          "when": "false"
        },
        {
          "command": "lineagelens.copyCode",
          "when": "false"
        },
        {
          "command": "lineagelens.deleteCapture",
          "when": "false"
        },
        {
          "command": "lineagelens.revealInFile",
          "when": "false"
        },
        {
          "command": "lineagelens.openCapture",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "LineageLens Base",
      "properties": {
        "lineagelensBase.minInsertionLines": {
          "type": "number",
          "default": 4,
          "minimum": 1,
          "description": "Minimum number of consecutive lines inserted to trigger a capture."
        },
        "lineagelensBase.captureEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable or disable AI insertion capture."
        },
        "lineagelensBase.maxStoredCaptures": {
          "type": "number",
          "default": 1000,
          "minimum": 10,
          "description": "Maximum number of captures to keep locally."
        },
        "lineagelensBase.excludePatterns": {
          "type": "array",
          "default": [
            "**/node_modules/**",
            "**/.git/**",
            "**/dist/**"
          ],
          "description": "Glob patterns for files to exclude from capture."
        },
        "lineagelensBase.backendUrl": {
          "type": "string",
          "default": "",
          "description": "LineageLens backend URL for Easy Mode (e.g. http://localhost:8787). When set, captured insertions are POSTed to the backend. Leave empty for fully local-only capture."
        },
        "lineagelensBase.ingestToken": {
          "type": "string",
          "default": "",
          "description": "Bearer token for the LineageLens backend ingest endpoint. Required when backendUrl is set. Generate one from the backend admin panel."
        },
        "lineagelensBase.workspaceId": {
          "type": "string",
          "default": "vscode-capture",
          "description": "Workspace slug sent with every ingest payload. Must match the workspace configured on your backend."
        },
        "lineagelensBase.proxyHealthUrl": {
          "type": "string",
          "default": "http://localhost:8788/proxy-health",
          "description": "URL for the LineageLens proxy health check. Used to auto-detect Power Mode. Change only if the proxy runs on a non-default port."
        },
        "lineagelensBase.redactSecretsOnEgress": {
          "type": "boolean",
          "default": true,
          "description": "Scrub detected secrets (API keys, tokens, private keys) from captures before they leave this machine \u2014 i.e. on JSON/Agent Trace export and backend ingest. The locally stored copy is unaffected."
        },
        "lineagelensBase.clipboardPasteDetection": {
          "type": "boolean",
          "default": true,
          "description": "Read the clipboard to detect whether a large insertion was pasted rather than AI-generated (reduces false positives). The clipboard is read locally on this machine and is never stored or transmitted. Disable if you do not want any clipboard access."
        }
      }
    }
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --minify",
    "watch": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --sourcemap --watch",
    "package": "vsce package",
    "test": "jest"
  },
  "dependencies": {
    "minimatch": "^9.0.4"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.22.0",
    "esbuild": "^0.19.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.9",
    "typescript": "^5.3.0"
  }
}

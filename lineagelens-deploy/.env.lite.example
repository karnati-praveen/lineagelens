# LineageLens Lite — minimal config
# Copy this to .env and fill in the two required values below.

# REQUIRED — generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_generate_a_strong_random_secret_here
JWT_REFRESH_SECRET_KEY=CHANGE_ME_generate_a_different_secret_here

# OPTIONAL — set if you want AI-powered explanations of provenance records
# EXPLAIN_LLM_API_KEY=sk-...
# EXPLAIN_LLM_MODEL=gpt-4o-mini

# OPTIONAL — allow requests from your frontend dev server
# BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

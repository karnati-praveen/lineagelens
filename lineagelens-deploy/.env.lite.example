# LineageLens Lite — environment template
# Copy to .env and fill in the required values before running docker compose.

# ── Required ──────────────────────────────────────────────────────────────────

# Random string, at least 32 characters.  Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-use-a-long-random-string-at-least-32-chars

# ── Optional: auto-create first admin on startup ───────────────────────────────
# ADMIN_SEED_USERNAME=admin
# ADMIN_SEED_PASSWORD=changeme123!

# ── Optional: proxy ingest token ──────────────────────────────────────────────
# PROXY_INGEST_TOKEN=

# LineageLens Max — environment template
# Copy to .env and fill in the required values before running docker compose.

# ── Required ──────────────────────────────────────────────────────────────────

# Postgres superuser password.
POSTGRES_PASSWORD=change-me-strong-postgres-password

# Neo4j password (username defaults to neo4j).
NEO4J_PASSWORD=change-me-strong-neo4j-password
# NEO4J_USERNAME=neo4j

# JWT signing secrets — must be at least 32 characters each and different from each other.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-use-a-long-random-string-at-least-32-chars
JWT_REFRESH_SECRET_KEY=change-me-different-long-random-string-at-least-32

# ── Optional: proxy ───────────────────────────────────────────────────────────
# PROXY_INGEST_TOKEN=
# PROXY_UPSTREAM_URL=https://api.anthropic.com
# PROXY_WORKSPACE_ID=my-workspace

# ── Optional: LLM explain / embeddings ────────────────────────────────────────
# EXPLAIN_LLM_API_KEY=
# EMBEDDING_PROVIDER=hash
# EMBEDDING_API_KEY=

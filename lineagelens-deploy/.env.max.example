# This file ships as deploy/.env.example in the zip.
# Copy it to deploy/.env before running quickstart.sh or docker compose.
# quickstart.sh generates this file automatically with random secrets.
# Only these variables are needed — everything else is set in docker-compose.enterprise.yml.
POSTGRES_PASSWORD=replace-with-strong-password

NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=replace-with-strong-password

JWT_SECRET_KEY=replace-with-at-least-32-char-random-secret
JWT_REFRESH_SECRET_KEY=replace-with-at-least-32-char-random-secret

# Optional: only needed if the explanation endpoint calls an external LLM.
EXPLAIN_LLM_API_KEY=

# Proxy — captures AI output from any CLI or IDE into LineageLens.
# After quickstart completes, log in and paste your JWT token below, then
# restart the proxy:  docker compose ... restart proxy
PROXY_INGEST_TOKEN=
PROXY_UPSTREAM_URL=https://api.anthropic.com
PROXY_WORKSPACE_ID=proxy-capture

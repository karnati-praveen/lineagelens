APP_ENV=development
APP_TITLE=AI Provenance Backend
APP_VERSION=0.1.0

DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/provenance
PGVECTOR_DIMENSION=256
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800

NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=neo4j_password
NEO4J_DATABASE=neo4j

JWT_SECRET_KEY=replace-with-at-least-32-char-random-secret
JWT_REFRESH_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_AUDIENCE=provenance-api
JWT_ISSUER=provenance-backend
JWT_ACCESS_TOKEN_TTL_MINUTES=30
JWT_REFRESH_TOKEN_TTL_MINUTES=10080
JWT_REQUIRED_SCOPES=provenance:write provenance:read
AUTH_PASSWORD_MIN_LENGTH=8

BACKEND_CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
HTTP_MAX_BODY_BYTES=2000000
WS_MAX_MESSAGE_BYTES=2000000

# Optional: set to a Redis URL to enable shared rate limiting across multiple backend replicas.
# When unset the default in-memory limiter is used (correct for single-container deployments).
# REDIS_URL=redis://localhost:6379/0

RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_WS_WINDOW_SECONDS=60
RATE_LIMIT_WS_MAX_MESSAGES=120
RATE_LIMIT_WS_MAX_CONNECTIONS=30
RATE_LIMIT_MAX_TRACKED_KEYS=50000

EXPLAIN_LLM_API_URL=https://api.openai.com/v1/chat/completions
EXPLAIN_LLM_API_KEY=
EXPLAIN_LLM_MODEL=gpt-4o-mini
EXPLAIN_LLM_TIMEOUT_SECONDS=25

# Embeddings: set EMBEDDING_PROVIDER=openai and supply an API key for semantic search.
# Leave as "hash" for zero-config deterministic embeddings (no API key needed).
EMBEDDING_PROVIDER=hash
EMBEDDING_API_URL=https://api.openai.com/v1/embeddings
EMBEDDING_API_KEY=
EMBEDDING_MODEL_NAME=text-embedding-3-small

# Exclude development and infrastructure content from extension package.
.agents/**
.claude/**
.git/**
.github/**
.venv/**
lineagelens-backend/**
lineagelens-base-extension/**
lineagelens-config/**
lineagelens-deploy/**
lineagelens-demo/**
lineagelens-docs/**
lineagelens-k8s/**
lineagelens-marketing/**
lineagelens-ad/**
lineagelens-proxy/**
lineagelens-verifier/**
lineagelens-src/**
dist/**
!dist/extension.js
.vscode/**
data/**
outputs/**
reproduction_tests/**

# Local and build artifacts
**/*.map
**/*.ts
!**/*.d.ts
*.vsix

# Workspace files not needed in the VSIX
tsconfig.json
.gitignore
.env.plus.example
.env.max.example
lineagelens-docs/SHIP_PRODUCTS_COMMANDS.md
skills-lock.json
lineagelens-releases/**
lineagelens-scripts/**
lineagelens-cli/**
lineagelens-mcp/**
lineagelens-docs/shipping-modes.md

# Exclude all node_modules by default, then allow required root runtime native modules.
**/node_modules/**
!/node_modules/
!/node_modules/tree-sitter/**
!/node_modules/tree-sitter-javascript/**
!/node_modules/tree-sitter-python/**
!/node_modules/tree-sitter-typescript/**
!/node_modules/node-addon-api/**
!/node_modules/node-gyp-build/**

# Keep package metadata/docs
!package.json
!README.md
!lineagelens-docs/CHANGELOG.md
!LICENSE
!lineagelens-docs/SUPPORT.md

# Exclude development and infrastructure content from extension package.
.agents/**
.claude/**
.git/**
.github/**
.venv/**
backend/**
deploy/**
docs/**
lineagelens-ad/**
proxy/**
src/**
out/**
.vscode/**

# Local and build artifacts
**/*.map
**/*.ts
!**/*.d.ts
*.vsix

# Workspace files not needed in the VSIX
tsconfig.json
docker-compose.yml
docker-compose.team.yml
docker-compose.enterprise.yml
.gitignore
.env.team.example
.env.enterprise.example
docs/SHIP_PRODUCTS_COMMANDS.md
file.md
prafea
skills-lock.json
releases/**
scripts/**
docs/shipping-modes.md

# Exclude all node_modules by default, then allow required runtime native modules.
node_modules/**
!node_modules/
!node_modules/tree-sitter/**
!node_modules/tree-sitter-javascript/**
!node_modules/tree-sitter-python/**
!node_modules/tree-sitter-typescript/**
!node_modules/node-addon-api/**
!node_modules/node-gyp-build/**

# Keep package metadata/docs
!package.json
!README.md
!docs/CHANGELOG.md
!LICENSE
!docs/SUPPORT.md

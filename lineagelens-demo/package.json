{
  "name": "lineagelens-demo",
  "version": "1.0.0",
  "private": true,
  "description": "Remotion product demo for LineageLens — renders the scan-to-provenance story as an MP4.",
  "license": "MIT",
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "build": "remotion render src/index.ts LineageLensDemo out/lineagelens-demo.mp4",
    "build:social": "remotion render src/index.ts LineageLensDemoSquare out/lineagelens-demo-square.mp4",
    "build:hackathon": "remotion render src/index.ts HackathonDemo out/lineagelens-hackathon.mp4",
    "still": "remotion still src/index.ts LineageLensDemo out/poster.png --frame=90",
    "capture": "node scripts/capture-scan.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.499",
    "@remotion/media": "4.0.499",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.499"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "typescript": "5.9.3"
  }
}

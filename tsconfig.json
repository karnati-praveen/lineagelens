{
  "compilerOptions": {
    "module": "Node16",
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "outDir": "dist",
    "rootDir": "lineagelens-src",
    "sourceMap": true,
    "strict": true,
    "moduleResolution": "Node16",
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": [
    "lineagelens-src/**/*"
  ],
  "exclude": [
    "node_modules",
    ".vscode-test",
    "lineagelens-ad",
    "lineagelens-base-extension",
    "lineagelens-src/test",
    "lineagelens-demo",
    "__mocks__"
  ]
}
